<section class="section integration-highlight" aria-labelledby="integracoes-title">
  <div class="container integration-container">
    <header class="integration-section-header">
      <h2 id="integracoes-title" class="heading_h2">GoodWe Integrated Experiences</h2>
      <p class="paragraph_large text-color_secondary">
        Voice intelligence aligned to deliver total control in any scenario.
      </p>
    </header>
    <div class="integration-grid">
      <article class="integration-card" aria-labelledby="integration-alexa-title">
        <header class="integration-card__header">
          <p class="eyebrow">Integrations</p>
          <h2 id="integration-alexa-title" class="heading_h2">Alexa Integration</h2>
          <p class="paragraph_large">
            Control the entire GoodWe ecosystem by voice and receive generation, consumption, and automation data in seconds.
          </p>
        </header>
        <div class="integration-card__cta">
          <a href="#" class="button w-button integration-cta">View demo</a>
        </div>
        <figure class="integration-mockup">
          <video
            class="integration-media"
            src="{{ '/images/alexa.webm' | url }}"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          ></video>
          <figcaption class="paragraph_small text-color_secondary">
            Alexa Skill with real-time answers about energy and GoodWe alerts.
          </figcaption>
        </figure>
      </article>

      <article class="integration-card" aria-labelledby="integration-sems-title">
        <header class="integration-card__header">
          <p class="eyebrow">Integrations</p>
          <h2 id="integration-sems-title" class="heading_h2">SEMS Portal Integration</h2>
          <p class="paragraph_large">
            See how our solution can be implemented within the official GoodWe SEMS app with chat interaction and automations.
          </p>
        </header>
        <div class="integration-card__cta">
          <a href="#" class="button is-secondary w-button integration-cta">How it works in SEMS</a>
        </div>
        <figure class="integration-mockup">
          <video
            class="integration-media"
            src="{{ '/images/sems-portal-demo.mp4' | url }}"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
          ></video>
          <figcaption class="paragraph_small text-color_secondary">
            SEMS Portal with smart recommendations and one-touch commands.
          </figcaption>
        </figure>
      </article>
    </div>
  </div>
</section>
